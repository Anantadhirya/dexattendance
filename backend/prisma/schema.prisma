generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum AttendanceType {
  check_in
  check_out
}

model User {
  id             String        @id @default(uuid()) @db.VarChar(36)
  name           String        @db.VarChar(255)
  email          String        @unique @db.VarChar(255)
  passwordHash   String        @map("password_hash") @db.VarChar(255)
  isAdmin        Boolean       @default(false) @map("is_admin")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  workScheduleId String?       @map("work_schedule_id") @db.VarChar(36)
  workSchedule   WorkSchedule? @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  attendance     AttendanceRecord[]

  @@map("users")
}

model AttendanceRecord {
  id         String         @id @default(uuid()) @db.VarChar(36)
  userId     String         @map("user_id") @db.VarChar(36)
  type       AttendanceType
  timestamp  DateTime       @default(now())
  imageUrl   String?        @map("image_url") @db.VarChar(2048)
  latitude   Decimal?       @db.Decimal(10, 7)
  longitude  Decimal?       @db.Decimal(10, 7)
  notes      String?        @db.Text
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@map("attendance_records")
}

model WorkSchedule {
  id             String   @id @default(uuid()) @db.VarChar(36)
  name           String   @db.VarChar(255)
  startTime      DateTime @map("start_time") @db.Time(0)
  endTime        DateTime @map("end_time") @db.Time(0)
  lateThreshold  Int      @map("late_threshold")
  users          User[]

  @@map("work_schedules")
}
